<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Brand-red status bar with white icons. Opt out of Android 15 (API 35)
             forced edge-to-edge so the native statusBarColor is respected again
             (the JS StatusBar backgroundColor prop is a no-op under edge-to-edge). -->
        <item name="android:statusBarColor">#EF3A3A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Without this, the gap between one screen unmounting and the next
             painting falls through to Android's default (black) window
             background, showing a brief black flash during transitions. -->
        <item name="android:windowBackground">#FFFFFF</item>

        <!-- Native cold-start splash (Android 12+ SplashScreen API), set directly on
             AppTheme rather than swapping to a dedicated Theme.SplashScreen — the
             latter isn't an AppCompat descendant and crashes ReactActivity (it needs
             Theme.AppCompat). Background matches the Navratri splash's own top
             gradient color so the OS splash dissolves straight into it. Ignored
             (no-op, not a crash) below API 31. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#fdf2ec</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
    </style>

</resources>
