<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Production domain with proper SSL -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">kitchennetworkinternational.com</domain>
        <domain includeSubdomains="true">app.kitchennetworkinternational.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
