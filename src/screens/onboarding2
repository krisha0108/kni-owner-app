// screens/OnboardingScreen.js
import React, { useMemo, useRef, useState } from 'react';
import {
  View, Text, StyleSheet, Dimensions, Animated, TouchableOpacity,
  StatusBar, Platform
} from 'react-native';
import { SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';
import LinearGradient from 'react-native-linear-gradient';
import LottieView from 'lottie-react-native';

const { width: W, height: H } = Dimensions.get('window');

const C = {
  primary: '#EF3A3A', ink: '#1D2254', bg: '#F5F7FA', card: '#FFFFFF',
  text: '#0F172A', muted: '#6B7280'
};

// --- slides (use your existing lotties) ---
const SLIDES = [
  {
    key: 'equip',
    title: 'Manage Equipment Easily',
    subtitle: 'Track, schedule, and request services with just a tap.',
    lottie: require('../assets/images/gear.json'),
    gradient: ['#FFF4F4', '#FFE1E1', '#EF3A3A'],
  },
  {
    key: 'live',
    title: 'Live Service Monitoring',
    subtitle: 'Get real-time updates from field technicians.',
    lottie: require('../assets/images/tracking.json'),
    gradient: ['#F5F7FA', '#E9EEF8', '#9AA6FF'],
  },
  {
    key: 'dash',
    title: 'Role-Based Dashboards',
    subtitle: 'Tailored for Restaurant Owners & Engineers.',
    lottie: require('../assets/images/dashboard.json'),
    gradient: ['#1D2254', '#2B2F6B', '#EF3A3A'],
    dark: true,
  },
];

export default function OnboardingScreen({ navigation }) {
  const insets = useSafeAreaInsets();
  const scrollX = useRef(new Animated.Value(0)).current;
  const listRef = useRef(null);
  const [index, setIndex] = useState(0);

  const onNext = () => {
    if (index < SLIDES.length - 1) {
      listRef.current?.scrollToOffset({ offset: (index + 1) * W, animated: true });
    } else {
      navigation.replace('RestaurantLogin');
    }
  };

  const onSkip = () => navigation.replace('RestaurantLogin');

  // background gradient interpolates with scroll
  const bg = useMemo(() => {
    const input = SLIDES.map((_, i) => i * W);
    const c0 = scrollX.interpolate({
      inputRange: input,
      outputRange: SLIDES.map(s => s.gradient[0]),
    });
    const c1 = scrollX.interpolate({
      inputRange: input,
      outputRange: SLIDES.map(s => s.gradient[1]),
    });
    const c2 = scrollX.interpolate({
      inputRange: input,
      outputRange: SLIDES.map(s => s.gradient[2]),
    });
    return { c0, c1, c2 };
  }, [scrollX]);

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: C.bg }} edges={['top', 'left', 'right']}>
      <StatusBar translucent backgroundColor="transparent" barStyle="light-content" />
      {/* animated background */}
      <View style={StyleSheet.absoluteFill}>
        {/* three-stop gradient that morphs with slides */}
        <AnimatedLinear gradient={[bg.c0, bg.c1, bg.c2]} />
        {/* soft blobs for depth */}
        <AnimatedBlob scrollX={scrollX} />
      </View>

      {/* top bar */}
      <View style={[st.top, { paddingTop: insets.top + 4 }]}>
        <View style={st.brandDot}>
          <Text style={st.brandTxt}>KNI</Text>
        </View>
        <TouchableOpacity onPress={onSkip} style={st.skipBtn}>
          <Text style={st.skipTxt}>Skip</Text>
        </TouchableOpacity>
      </View>

      {/* pager */}
      <Animated.FlatList
        ref={listRef}
        data={SLIDES}
        keyExtractor={s => s.key}
        horizontal
        pagingEnabled
        bounces={false}
        showsHorizontalScrollIndicator={false}
        onScroll={Animated.event(
          [{ nativeEvent: { contentOffset: { x: scrollX } } }],
          { useNativeDriver: false }
        )}
        onMomentumScrollEnd={e => setIndex(Math.round(e.nativeEvent.contentOffset.x / W))}
        renderItem={({ item }) => (
          <View style={{ width: W, paddingHorizontal: 20 }}>
            {/* glass card */}
            <View style={st.cardWrap}>
              <View style={st.glass}>
                <LottieView
                  source={item.lottie}
                  autoPlay
                  loop
                  style={{ width: W * 0.76, height: H * 0.36 }}
                />
              </View>
            </View>

            <View style={{ alignItems: 'center', marginTop: 24 }}>
              <Text style={[st.title, item.dark && { color: '#fff' }]}>{item.title}</Text>
              <Text style={[st.subtitle, item.dark && { color: '#E9ECFF' }]}>
                {item.subtitle}
              </Text>
            </View>
          </View>
        )}
      />

      {/* progress + ctas */}
      <View style={[st.footer, { paddingBottom: (insets.bottom || 16) + 8 }]}>
        <ProgressPills scrollX={scrollX} count={SLIDES.length} />
        <TouchableOpacity onPress={onNext} style={st.cta}>
          <Text style={st.ctaTxt}>{index === SLIDES.length - 1 ? "Let’s Go" : "Next"}</Text>
        </TouchableOpacity>
      </View>
    </SafeAreaView>
  );
}

/* ---------- tiny helpers ---------- */
function AnimatedLinear({ gradient }) {
  // Animated wrapper over LinearGradient (3 stops)
  return (
    <Animated.View style={{ flex: 1 }}>
      <LinearGradient
        style={{ flex: 1 }}
        start={{ x: 0.1, y: 0.0 }}
        end={{ x: 1, y: 1 }}
        colors={['#ffffff', '#ffffff', '#ffffff']} // will be visually covered by overlay below
      />
      {/* overlay where we animate via backgroundColor on three stacked views */}
      <Animated.View style={[StyleSheet.absoluteFill, { backgroundColor: gradient[0] }]} />
      <Animated.View style={[StyleSheet.absoluteFill, { opacity: 0.6, backgroundColor: gradient[1] }]} />
      <Animated.View style={[StyleSheet.absoluteFill, { opacity: 0.35, backgroundColor: gradient[2] }]} />
    </Animated.View>
  );
}

function AnimatedBlob({ scrollX }) {
  const input = SLIDES.map((_, i) => i * W);
  const translateX = scrollX.interpolate({
    inputRange: input,
    outputRange: [ -40, 0, 40 ],
    extrapolate: 'clamp',
  });
  const scale = scrollX.interpolate({
    inputRange: input,
    outputRange: [1, 1.06, 1],
  });
  return (
    <Animated.View pointerEvents="none" style={[StyleSheet.absoluteFill, { alignItems: 'center' }]}>
      <Animated.View
        style={{
          width: W * 0.85, height: W * 0.85, borderRadius: W,
          backgroundColor: 'rgba(255,255,255,0.18)',
          transform: [{ translateX }, { scale }],
          top: H * 0.08,
          shadowColor: '#000', shadowOpacity: 0.15, shadowRadius: 20, elevation: 6,
        }}
      />
    </Animated.View>
  );
}

function ProgressPills({ scrollX, count }) {
  return (
    <View style={st.progress}>
      {Array.from({ length: count }).map((_, i) => {
        const input = [ (i - 1) * W, i * W, (i + 1) * W ];
        const w = scrollX.interpolate({
          inputRange: input, outputRange: [10, 28, 10], extrapolate: 'clamp',
        });
        const op = scrollX.interpolate({
          inputRange: input, outputRange: [0.4, 1, 0.4], extrapolate: 'clamp',
        });
        return (
          <Animated.View key={i} style={[st.dot, { width: w, opacity: op }]} />
        );
      })}
    </View>
  );
}

/* ---------- styles ---------- */
const st = StyleSheet.create({
  top: {
    paddingHorizontal: 16,
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  brandDot: {
    backgroundColor: '#FFFFFFAA',
    paddingHorizontal: 12, paddingVertical: 6, borderRadius: 999,
    borderWidth: 1, borderColor: '#FFFFFF66',
  },
  brandTxt: { color: C.ink, fontWeight: '900', letterSpacing: 0.5 },
  skipBtn: {
    paddingHorizontal: 12, paddingVertical: 8,
    backgroundColor: '#FFFFFF22', borderRadius: 999, borderWidth: 1, borderColor: '#FFFFFF55',
  },
  skipTxt: { color: '#fff', fontWeight: '700' },

  cardWrap: { alignItems: 'center', marginTop: H * 0.06 },
  glass: {
    width: W * 0.86, height: H * 0.46,
    backgroundColor: 'rgba(255,255,255,0.28)',
    borderRadius: 24,
    borderWidth: 1, borderColor: '#FFFFFF88',
    alignItems: 'center', justifyContent: 'center',
    shadowColor: '#000', shadowOpacity: 0.15, shadowRadius: 20, elevation: 6,
    overflow: 'hidden',
  },

  title: { fontSize: 28, fontWeight: '900', color: C.ink, textAlign: 'center' },
  subtitle: {
    marginTop: 8, fontSize: 16, lineHeight: 22, color: '#20304A',
    textAlign: 'center', paddingHorizontal: 30,
  },

  footer: {
    position: 'absolute', bottom: 0, left: 0, right: 0,
    paddingHorizontal: 16, paddingTop: 12,
    flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
  },
  progress: { flexDirection: 'row', gap: 8, backgroundColor: '#FFFFFF55', padding: 8, borderRadius: 999 },
  dot: { height: 10, borderRadius: 999, backgroundColor: '#fff' },

  cta: {
    backgroundColor: C.ink, borderRadius: 18, paddingVertical: 12, paddingHorizontal: 20,
    shadowColor: '#000', shadowOpacity: 0.2, shadowRadius: 12, elevation: 5,
  },
  ctaTxt: { color: '#fff', fontWeight: '800', fontSize: 15 },
});
